{
  "permissions": {
    "deny": [
      "Artifact"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.agent-tools/scope_guard.py",
              "--claude-hook"
            ]
          }
        ]
      }
    ]
  }
}
