{
  "permissions": {
    "deny": [
      "Artifact"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.agent-tools/scope_guard.py",
              "--claude-hook"
            ]
          }
        ]
      },
      {
        "matcher": "Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.agent-tools/read_guard.py",
              "check",
              "--claude-hook"
            ]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.agent-tools/command_guard.py",
              "--claude-hook"
            ]
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.agent-tools/read_guard.py",
              "shell",
              "--claude-hook"
            ]
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.agent-tools/command_guard.py",
              "--claude-hook"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.agent-tools/read_guard.py",
              "record",
              "--claude-hook"
            ]
          }
        ]
      }
    ]
  }
}
